{
    "name": "@highcharts/grid-pro-react",
    "version": "3.3.0",
    "description": "Official React data grid component for Highcharts Grid Pro. Editable React table with validation, sparklines, events, sorting, filtering and row virtualization.",
    "type": "module",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "LICENSE.txt",
        "README.md"
    ],
    "keywords": [
        "highcharts",
        "highcharts-grid",
        "react",
        "react-component",
        "react-grid",
        "react-data-grid",
        "react-table",
        "data-grid",
        "datagrid",
        "data-table",
        "datatable",
        "grid",
        "table",
        "editable",
        "validation",
        "sparklines",
        "virtualization",
        "accessibility",
        "typescript",
        "nextjs",
        "pro"
    ],
    "author": "Highsoft AS",
    "license": "SEE LICENSE.txt",
    "repository": {
        "type": "git",
        "url": "https://github.com/highcharts/grid-react.git",
        "directory": "packages/grid-pro-react"
    },
    "homepage": "https://www.highcharts.com/docs/grid/frameworks/react/getting-started",
    "bugs": {
        "url": "https://github.com/highcharts/grid-react/issues"
    },
    "scripts": {
        "build": "pnpm clean:dist && rollup -c",
        "lint": "eslint src --ext .ts,.tsx",
        "clean:dist": "rimraf dist",
        "clean": "rimraf node_modules dist",
        "prepublishOnly": "pnpm build"
    },
    "devDependencies": {
        "@highcharts/grid-shared-react": "workspace:*",
        "@rollup/plugin-commonjs": "^29.0.0",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@types/react": ">=18",
        "@types/react-dom": ">=18",
        "react": ">=18",
        "react-dom": ">=18",
        "rollup": "^4.53.3",
        "rollup-plugin-dts": "^6.3.0"
    },
    "peerDependencies": {
        "@highcharts/grid-pro": ">=3.1.0",
        "@types/react": ">=18",
        "@types/react-dom": ">=18",
        "react": ">=18",
        "react-dom": ">=18"
    },
    "peerDependenciesMeta": {
        "@types/react": {
            "optional": true
        },
        "@types/react-dom": {
            "optional": true
        }
    }
